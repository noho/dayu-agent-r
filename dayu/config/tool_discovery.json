      "source_id": "dayu.tools.doc_provider",
      "enabled": false,
      "config": {
        "allowed_paths": [],
        "limits": {
          "list_files_max": 200,
          "get_sections_max": 200,
          "search_files_max_results": 50,
          "read_file_max_chars": 80000,
          "read_file_section_max_chars": 50000
