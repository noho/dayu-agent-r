{
  "schema_version": 1,
  "scene": "interactive",
  "version": "v1",
  "description": "交互式财报分析场景",
  "capability_tags": [
    "interactive"
  ],
  "extends": [],
  "model": {
    "default_model_id": "mimo-v2.5-pro-thinking-plan",
    "runner_option_hint_id": "interactive"
  },
  "agent_policy": {
    "max_iterations": 20
  },
  "tool_selection": {
    "mode": "select",
    "tool_names": [],
    "tool_tags_any": [
      "fins-read",
      "fins-download",
      "fins-preprocess",
      "web",
      "utils"
    ],
    "allow_empty": false
  },
  "defaults": {
    "missing_required_fragment": "fail_closed"
  },
  "fragments": [
    {
      "id": "base_agents",
      "path": "base/agents.md",
      "order": 100,
      "required": true
    },
    {
      "id": "base_soul",
      "path": "base/soul.md",
      "order": 200,
      "required": true
    },
    {
      "id": "base_fact_rules",
      "path": "base/fact_rules.md",
      "order": 300,
      "required": true
    },
    {
      "id": "base_tools",
      "path": "base/tools.md",
      "order": 400,
      "required": true
    },
    {
      "id": "interactive_scene",
      "path": "scenes/interactive.md",
      "order": 500,
      "required": true
    }
  ],
  "context_slots": [
    {
      "name": "current_time",
      "value_type": "string",
      "required": true
    }
  ]
}
