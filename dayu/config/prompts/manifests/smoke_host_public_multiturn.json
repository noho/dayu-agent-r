      "required": true
    },
    {
      "id": "base_fact_rules",
      "path": "base/fact_rules.md",
      "order": 200,
      "required": true
    },
    {
      "id": "smoke_host_public_multiturn_scene",
      "path": "scenes/smoke_host_public_multiturn.md",
      "order": 300,
      "required": true
    }
  ],
  "context_slots": [
    {
      "name": "fins_default_subject",
      "value_type": "string",
      "required": true
    },
    {
      "name": "base_user",
      "value_type": "string",
      "required": true
    }
  ]
}
