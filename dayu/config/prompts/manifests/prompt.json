{
  "schema_version": 1,
  "scene": "prompt",
  "version": "v1",
  "description": "单轮财报问答场景",
  "capability_tags": [
    "prompt"
  ],
  "extends": [],
  "model": {
    "default_model_id": "mimo-v2.5-pro-thinking-plan",
    "runner_option_hint_id": "prompt"
  },
  "agent_policy": {
    "max_iterations": 24
  },
  "tool_selection": {
    "mode": "select",
    "tool_names": [],
    "tool_tags_any": [
      "fins-read",
      "web",
      "utils"
    ],
    "allow_empty": false
  },
  "defaults": {
    "missing_required_fragment": "fail_closed"
  },
  "fragments": [
    {
      "id": "base_agents",
      "path": "base/agents.md",
      "order": 100,
      "required": true
    },
    {
      "id": "base_soul",
      "path": "base/soul.md",
      "order": 200,
      "required": true
    },
    {
      "id": "base_fact_rules",
      "path": "base/fact_rules.md",
      "order": 300,
      "required": true
    },
    {
      "id": "base_tools",
      "path": "base/tools.md",
      "order": 400,
      "required": true
    },
    {
      "id": "prompt_scene",
      "path": "scenes/prompt.md",
      "order": 500,
      "required": true
    }
  ],
  "context_slots": [
    {
      "name": "current_time",
      "value_type": "string",
      "required": true
    },
    {
      "name": "fins_default_subject",
      "value_type": "string",
      "required": true
    }
  ]
}
